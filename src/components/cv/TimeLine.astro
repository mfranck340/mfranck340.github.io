---
const { title, subtitle, badge } = Astro.props;
---

<div class="group flex gap-4">
  <div class="flex flex-col items-center">
    <span class="mt-2 h-4 w-4 rounded-full border-4 border-base-100 bg-primary shadow-sm ring-2 ring-primary/30"></span>
    <span class="block h-full w-[2px] bg-base-300 transition-colors group-hover:bg-primary/60"></span>
  </div>

  <div class="mb-4 w-full rounded-lg border border-base-300 bg-base-100 p-5 shadow-sm transition-all duration-200 group-hover:-translate-y-0.5 group-hover:border-primary/50 group-hover:shadow-md">
    <div class="mb-2 flex flex-wrap items-start justify-between gap-3">
      <h3 class="text-lg font-bold leading-snug">{title}</h3>
      {badge && <span class="badge badge-outline shrink-0">{badge}</span>}
    </div>
    <span class="text-sm font-semibold text-primary">{subtitle}</span>
    <p class="mt-3 text-base-content/75">
      <slot />
    </p>
  </div>
</div>
