---
const { sideBarActiveItemID } = Astro.props;
const linkClass =
  "sidebar-menu-link py-3 text-base transition-colors duration-150 hover:bg-base-300/70 focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary";
const activeClass = "bg-primary text-primary-content font-semibold hover:bg-primary";
const getLinkClass = (itemID: string) =>
  itemID === sideBarActiveItemID ? `${linkClass} ${activeClass}` : linkClass;
---

<ul class="menu grow shrink menu-md overflow-y-auto relative z-10">
    <li><a class={getLinkClass("home")} id="home" href="/" data-analytics-event="navigation_click" data-analytics-category="navigation" data-analytics-label="home">Home</a></li>
    <li><a class={getLinkClass("news")} id="news" href="/news" data-analytics-event="navigation_click" data-analytics-category="navigation" data-analytics-label="news">News & Updates</a></li>
    <li><a class={getLinkClass("publications")} id="publications" href="/publications" data-analytics-event="navigation_click" data-analytics-category="navigation" data-analytics-label="publications">Publications</a></li>
    <li><a class={getLinkClass("cv")} id="cv" href="/cv" data-analytics-event="navigation_click" data-analytics-category="navigation" data-analytics-label="cv">CV</a></li>
    <!-- <li>
        <a
            class="py-3 text-base"
            href="mailto:contact.manuelernestog@gmail.com"
            target="_blank"
            referrerpolicy="no-referrer-when-downgrade">Contact</a
        >
    </li> -->
</ul>

<style>
  .sidebar-menu-link:active {
    background-color: hsl(var(--p) / 0.9);
    color: hsl(var(--pc));
  }
</style>
