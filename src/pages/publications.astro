---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Publications" sideBarActiveItemID="publications">
  <section class="mb-10 mt-5">
    <div class="mb-8 border-b border-base-300 pb-5">
      <p class="text-sm font-semibold uppercase tracking-wide text-primary">Research output</p>
      <h1 class="mt-1 text-4xl font-bold">Publications</h1>
      <p class="mt-3 max-w-3xl text-base-content/75">
        This section is being prepared and will be available soon.
      </p>
    </div>

    <div class="rounded-lg border border-base-300 bg-base-100 p-8 text-center shadow-sm">
      <p class="text-sm font-semibold uppercase tracking-wide text-primary">Coming soon</p>
      <h2 class="mt-2 text-3xl font-bold">Working on it</h2>
      <p class="mx-auto mt-4 max-w-2xl text-base-content/75">
        I am currently organizing this section. Publications, papers, and related research material will be added here once the page is ready.
      </p>
    </div>
  </section>
</BaseLayout>
