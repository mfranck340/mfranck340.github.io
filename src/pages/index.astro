---
import BaseLayout from "../layouts/BaseLayout.astro";
import { news } from '../content/news';

// const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
// const last_posts = posts.slice(0, 3);
const latestNews = news
  .flatMap((yearGroup) => yearGroup.items.map((item) => ({ ...item, year: yearGroup.year })))
  .slice(0, 2);
---



<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-5xl font-bold">I'm Franck Fierro</div>
    <div class="text-3xl py-3 font-bold">PhD student in AI for Controll and Decision Making in Autonomous Driving </div>
    <div class="py-2">
      <text class="text-lg">
        Hey there 👋 My name is Franck Fierro. 
        I obtained a BSc in <b>Computer Science</b> in 2024 and a MSc in <b>Cibersecurity</b> in 2025, both from the 
        <a href="https://www.uah.es/es/" style="color: #4f46e5; text-decoration: none;" data-analytics-event="profile_link_click" data-analytics-category="engagement" data-analytics-label="uah">University of Alcalá (UAH)</a>.
        Currently I am a PhD student at UAH focused on <b>Decision Making and Control</b>,
        as a member of the research staff in the <a href="https://www.linkedin.com/company/robesafe-research-group/" style="color: #4f46e5; text-decoration: none;" data-analytics-event="profile_link_click" data-analytics-category="engagement" data-analytics-label="robesafe_group">RobeSafe Research Group</a>, 
        in the Electronics Department.
        My research interests cover Artificial Intelligence, Vehicle Motion and Self-Driving Vehicle Architectures.
        </text>
    </div>
  </div>

  <div class="my-8"></div>
  <!-- Latest News -->
  <section class="mb-12">
    <div class="mb-6 border-l-4 border-primary pl-5">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wide text-primary">Recent activity</p>
          <h2 class="mt-1 text-4xl font-bold leading-tight">Latest News</h2>
          <p class="mt-2 max-w-2xl text-base-content/70">
            A quick snapshot of recent research updates, papers, and academic milestones.
          </p>
        </div>
        <a href="/news" class="btn btn-sm btn-primary shrink-0" data-analytics-event="navigation_click" data-analytics-category="navigation" data-analytics-label="latest_news_view_all">
          View all
        </a>
      </div>
    </div>

    <div class="grid gap-4 md:grid-cols-2">
      {latestNews.map((item) => (
        <article class="group rounded-lg border border-base-300 bg-base-200/70 p-5 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-primary/60 hover:bg-base-200 hover:shadow-md">
          <div class="mb-4 flex items-center justify-between gap-3">
            <div class="rounded-md bg-primary px-3 py-2 text-primary-content">
              <span class="block text-xs font-semibold uppercase leading-none">{item.date}</span>
              <span class="mt-1 block text-lg font-bold leading-none">{item.year}</span>
            </div>
            <span class="h-px flex-1 bg-base-300 transition-colors group-hover:bg-primary/40"></span>
          </div>

          <h3 class="mb-3 text-xl font-bold leading-snug">
            {'link' in item && item.link ? (
              <a
                href={item.link}
                class="inline-flex items-center gap-2 transition-colors hover:text-primary"
                data-analytics-event="news_link_click"
                data-analytics-category="research"
                data-analytics-label={`${item.year}-${item.date}-${item.title.replace(/<[^>]*>/g, "")}`}
              >
                <span set:html={item.title} />
                {'icon' in item && item.icon && <span class="shrink-0" set:html={item.icon} />}
              </a>
            ) : (
              <span class="inline-flex items-center gap-2">
                <span set:html={item.title} />
                {'icon' in item && item.icon && <span class="shrink-0" set:html={item.icon} />}
              </span>
            )}
          </h3>

          <p class="text-base-content/75" set:html={item.description}></p>
        </article>
      ))}
    </div>
  </section>


</BaseLayout>
